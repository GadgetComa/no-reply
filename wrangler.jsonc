async function authMiddleware(c, next) {
  const env = c.env;
  const path = new URL(c.req.url).pathname;
  if (path === "/admin/login") {
    return next();
  }
  if (checkProxyAuth(c, env)) {
    return next();
  }
  const authCookie = await getSignedCookie(
    c,
    env.ADMIN_PASSWORD,
    ADMIN_COOKIE_NAME
  );
  if (authCookie !== "1") {
    return c.redirect("/admin/login");
  }
  await next();
}
