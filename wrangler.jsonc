      const snippet = compact(String(text || '').replace(/\\s+/g, ' ').trim(), 140);
      const fallbackParts = [safePrefix + ' (HTTP ' + status + ')'];
      if (snippet) fallbackParts.push('- ' + snippet);
      if (cfRayHeader) fallbackParts.push('(cf-ray ' + cfRayHeader + ')');
