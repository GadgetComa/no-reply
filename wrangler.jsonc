{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "no-reply-autoresponder",
  "main": "no-reply-autoresponder.js",
  "compatibility_date": "2026-08-20",
  "workers_dev": false,
  "preview_urls": false,
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}
